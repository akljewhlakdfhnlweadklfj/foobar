{
  "name": "Consensus News",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  // First creation only: seed every vertical from feeds/*.txt and load 3 days of history from Feedly.
  "postCreateCommand": "python3 app.py --backfill 3 --no-serve",
  // Every start (including after the Codespace wakes from being stopped): run the server.
  "postStartCommand": "nohup python3 app.py --host 0.0.0.0 --port 8000 > /tmp/news-aggregator.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Consensus News", "onAutoForward": "openBrowser" }
  }
}
